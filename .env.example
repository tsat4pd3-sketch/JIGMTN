# ── MySQL backend ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_password
DB_NAME=jig_pm

# Port the Express API listens on
PORT=3001

# Allow cross-origin from this extra origin (optional, React dev server auto-allowed)
# CORS_ORIGIN=https://yourdomain.com

# ── Frontend (Vite reads VITE_* vars at build time) ─────────────────────────────
# Set this so the React app calls the Express backend instead of GitHub Issues
VITE_SQL_API_URL=http://localhost:3001

# GitHub fallback (leave blank if using MySQL)
# VITE_GITHUB_TOKEN=ghp_xxx
# VITE_GITHUB_REPO=tsat4pd3-sketch/JIGMTN

# Optional API key to protect the Express API
# VITE_SQL_API_KEY=secret123
# SQL_API_KEY=secret123
